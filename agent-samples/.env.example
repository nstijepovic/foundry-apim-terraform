# Environment Configuration
# Copy this file to .env and fill in the values from your deployment.
#
# Get these from Terraform in the deployment folder you applied:
#   terraform output foundry_account_name   -> <account>
#   terraform output project_name           -> <project>
#   connection name = var.model_gateway_connection_name (e.g. fednet-gateway)
#   model = a model declared in var.model_gateway_static_models (e.g. glm-5.2)

# Azure AI Foundry Project endpoint (data-plane).
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Gateway connection name + a model served through it.
AZURE_AI_CONNECTION_NAME=fednet-gateway
AZURE_AI_MODEL_NAME=glm-5.2

# Agent name (used by chat_with_agent.py).
AZURE_AI_AGENT_NAME=gateway-agent

# Authentication: Uses DefaultAzureCredential, which picks up your `az login` session.
# No need for AZURE_TENANT_ID unless you have multi-tenant scenarios.
