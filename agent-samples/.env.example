# Environment Configuration
# Copy this file to .env and fill in the values from your spoke deployment.
#
# Get these from Terraform in ../spoke-private-agent:
#   terraform output foundry_account_name   -> <account>
#   terraform output project_name            -> <project>
#   connection name = var.apim_openai_connection_name (e.g. hub-apim-openai)
#   model = the deployment exposed behind the hub APIM (e.g. gpt-5.1)

# Azure AI Foundry Project endpoint (data-plane, private).
# Format: https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# APIM connection name + the model deployment exposed behind the hub APIM.
AZURE_AI_CONNECTION_NAME=hub-apim-openai
AZURE_AI_MODEL_NAME=gpt-5.1

# Agent name (used by chat_with_agent.py).
AZURE_AI_AGENT_NAME=apim-agent

# Authentication: Uses DefaultAzureCredential, which picks up your `az login` session.
# No need for AZURE_TENANT_ID unless you have multi-tenant scenarios.
